---
import type { team } from '../data/collection';
interface Props { members: typeof team; }
const { members } = Astro.props;
type Member = (typeof team)[number];
---
<section class="about-section reveal" id="about">
  <div class="about-header">
    <div class="sec-ey">THE FACES BEHIND IT</div>
    <h2 class="about-heading"><em>Two women. One brand.</em></h2>
    <p class="about-subtitle">Built from scratch. Still building.</p>
  </div>

  <div class="about-grid">
    {members.map((m, i) => (
      <div class="person-card" data-sound={i === 0 ? 'chime' : 'swoosh'} style={`--accent:${(m as Member).accent};--avatar-bg:${(m as Member).avatarBg}`}>
        <div class="person-avatar">{m.initial}</div>
        <div class="person-label">{m.label}</div>
        <div class="person-name">{m.name}</div>
        <div class="person-role">{m.role}</div>
        <p class="person-bio">{m.bio}</p>
        <div class="person-socials">
          <a href={`mailto:${(m as Member).email}`} class="person-social" aria-label={`Email ${m.name}`}>
            <svg viewBox="0 0 24 24"><rect x="2" y="4" width="20" height="16" rx="2"/><polyline points="2,4 12,13 22,4"/></svg>
          </a>
          <a href={(m as Member).linkedin} target="_blank" rel="noopener noreferrer" class="person-social" aria-label={`${m.name} on LinkedIn`}>
            <svg viewBox="0 0 24 24"><rect x="2" y="2" width="20" height="20" rx="3"/><line x1="7" y1="10" x2="7" y2="17"/><circle cx="7" cy="6.5" r="1.2" fill="currentColor" stroke="none"/><path d="M11 17v-7M11 13.5c0-2 1.4-3.5 3.3-3.5s3.2 1.5 3.2 3.5V17"/></svg>
          </a>
        </div>
      </div>
    ))}
  </div>

  <div class="about-contact" id="contact">
    <span class="contact-lbl">Get in touch</span>
    <div class="contact-list">
      <a href="mailto:Zhadoree@gmail.com" class="clink">
        <div class="clink-ico">
          <svg viewBox="0 0 24 24"><rect x="2" y="4" width="20" height="16" rx="2"/><polyline points="2,4 12,13 22,4"/></svg>
        </div>
        Zhadoree@gmail.com
      </a>
      <a href="https://www.instagram.com/zh.adore/" target="_blank" rel="noopener noreferrer" class="clink">
        <div class="clink-ico">
          <svg viewBox="0 0 24 24"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>
        </div>
        @zh.adore
      </a>
    </div>
  </div>
</section>

<script>
  let audioCtx: AudioContext | null = null;
  function getCtx() {
    if (!audioCtx) audioCtx = new AudioContext();
    return audioCtx;
  }

  function playChime() {
    const ctx = getCtx();
    const now = ctx.currentTime;
    // Soft ascending arpeggio in A major — melodic and peaceful
    // [frequency, startDelay, peakGain, duration]
    const notes: [number, number, number, number][] = [
      [440,  0.00, 0.07, 2.4],
      [554,  0.10, 0.05, 2.2],
      [659,  0.20, 0.04, 2.0],
      [880,  0.32, 0.03, 1.8],
    ];
    notes.forEach(([freq, delay, vol, dur]) => {
      const osc  = ctx.createOscillator();
      const gain = ctx.createGain();
      osc.connect(gain); gain.connect(ctx.destination);
      osc.type = 'sine';
      osc.frequency.setValueAtTime(freq, now + delay);
      gain.gain.setValueAtTime(0, now + delay);
      gain.gain.linearRampToValueAtTime(vol, now + delay + 0.04);
      gain.gain.exponentialRampToValueAtTime(0.0001, now + delay + dur);
      osc.start(now + delay);
      osc.stop(now + delay + dur);
    });
  }

  function playSwoosh() {
    const ctx = getCtx();
    const now = ctx.currentTime;

    // Devil Wears Prada-inspired fashion sting:
    // confident ascending phrase (E minor → landing on B) with warmth & subtle echo
    const notes: [number, number, number, number][] = [
      [330, 0.00, 0.07, 0.22],   // E4  — opening
      [415, 0.12, 0.08, 0.22],   // G#4 — tension
      [523, 0.23, 0.09, 0.30],   // C5  — rise
      [659, 0.35, 0.11, 0.75],   // E5  — confident landing, held
    ];

    // Subtle echo for depth
    const echo     = ctx.createDelay(1.0);
    echo.delayTime.value = 0.2;
    const echoGain = ctx.createGain();
    echoGain.gain.value  = 0.12;
    echo.connect(echoGain);
    echoGain.connect(ctx.destination);

    notes.forEach(([freq, offset, vol, dur]) => {
      const osc    = ctx.createOscillator();
      const harm   = ctx.createOscillator();
      const filt   = ctx.createBiquadFilter();
      const gain   = ctx.createGain();

      osc.type  = 'triangle';   // warm, string-like body
      harm.type = 'sine';        // smooth upper harmonic
      osc.frequency.setValueAtTime(freq, now + offset);
      harm.frequency.setValueAtTime(freq * 2, now + offset);

      filt.type = 'lowpass';
      filt.frequency.value = 3200;
      filt.Q.value = 0.4;

      osc.connect(filt); harm.connect(filt);
      filt.connect(gain);
      gain.connect(ctx.destination);
      gain.connect(echo);

      gain.gain.setValueAtTime(0, now + offset);
      gain.gain.linearRampToValueAtTime(vol, now + offset + 0.025);
      gain.gain.exponentialRampToValueAtTime(0.0001, now + offset + dur);

      osc.start(now + offset);  osc.stop(now + offset + dur + 0.1);
      harm.start(now + offset); harm.stop(now + offset + dur + 0.1);
    });
  }

  document.querySelectorAll<HTMLElement>('.person-card[data-sound]').forEach(card => {
    let cooldown = false;
    card.addEventListener('mouseenter', () => {
      if (cooldown) return;
      cooldown = true;
      setTimeout(() => cooldown = false, 600);
      if (card.dataset.sound === 'chime') playChime();
      else playSwoosh();
    });
  });
</script>
