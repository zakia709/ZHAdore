---
// src/layouts/BaseLayout.astro
// Main layout wrapper — used by all pages
import BaseHead from './BaseHead.astro';
import SkipLink from '@components/SkipLink.astro';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import CookieBanner from '@components/CookieBanner.astro';
import '@styles/global.css';

export interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  canonicalURL?: string;
  noindex?: boolean;
}
const props = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <BaseHead {...props} />
  </head>
  <body>
    <SkipLink />
    <Header />

    <main id="main-content">
      <slot />
    </main>

    <div id="upcycling-modal" class="upcycling-modal" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="upcycling-title">
      <div class="upcycling-modal-overlay" data-close-upcycling></div>
      <div class="upcycling-modal-card">
        <button class="upcycling-modal-close" type="button" aria-label="Close upcycling event popup" data-close-upcycling>×</button>
        <div class="upcycling-modal-label">NEW YORK CITY · COMING SOON</div>
        <div class="upcycling-modal-line"></div>
        <h2 id="upcycling-title">Something is being unmade.</h2>
        <p class="upcycling-modal-subheading">And rebuilt into something better.</p>
        <p class="upcycling-modal-description">ZHADORE is coming to New York with an upcycling event — bringing discarded fabric back to life, one piece at a time. If you believe nothing should go to waste, this one is for you.</p>
        <form class="upcycling-form" data-upcycling-form>
          <input type="email" name="email" placeholder="your@email.com" aria-label="Email address" required />
          <button type="submit">NOTIFY ME</button>
        </form>
        <p class="upcycling-success" data-upcycling-success hidden>You're on the list. We'll see you in New York. ✦</p>
        <p class="upcycling-modal-note">Upcycling Event · New York City · 2026</p>
      </div>
    </div>

    <Footer />
    <CookieBanner />

    <style>
      .upcycling-modal {
        position: fixed;
        inset: 0;
        z-index: 1000;
        display: none;
      }

      .upcycling-modal[aria-hidden="false"] {
        display: block;
      }

      .upcycling-modal-overlay {
        position: absolute;
        inset: 0;
        background: rgba(0, 0, 0, 0.75);
        backdrop-filter: blur(6px);
      }

      .upcycling-modal-card {
        position: fixed;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: min(520px, 90%);
        max-width: 520px;
        padding: 52px 48px;
        background: #0E0E0E;
        border: 1px solid rgba(196, 145, 58, 0.25);
        border-radius: 4px;
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.4);
        animation: fadeUp 0.4s ease;
      }

      .upcycling-modal-close {
        position: absolute;
        top: 16px;
        right: 20px;
        border: none;
        background: none;
        color: rgba(244, 239, 230, 0.4);
        font-size: 20px;
        cursor: pointer;
        line-height: 1;
      }

      .upcycling-modal-close:hover {
        color: #F4EFE6;
      }

      .upcycling-modal-label {
        font-family: var(--font-sans);
        font-size: 10px;
        letter-spacing: 4px;
        color: #C4913A;
        margin-bottom: 20px;
        text-transform: uppercase;
      }

      .upcycling-modal-line {
        width: 40px;
        height: 1px;
        background: #C4913A;
        margin-bottom: 24px;
      }

      .upcycling-modal-card h2 {
        font-family: var(--font-serif);
        font-size: 36px;
        font-weight: 300;
        color: #F4EFE6;
        line-height: 1.1;
        margin-bottom: 8px;
      }

      .upcycling-modal-subheading {
        font-family: var(--font-serif);
        font-size: 22px;
        font-weight: 300;
        color: rgba(244, 239, 230, 0.45);
        margin-bottom: 24px;
      }

      .upcycling-modal-description {
        font-family: var(--font-sans);
        font-size: 13px;
        font-weight: 300;
        color: rgba(244, 239, 230, 0.45);
        line-height: 1.9;
        margin-bottom: 32px;
      }

      .upcycling-form {
        display: flex;
        gap: 0;
      }

      .upcycling-form input {
        flex: 1;
        padding: 13px 20px;
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid rgba(196, 145, 58, 0.2);
        border-right: none;
        color: #F4EFE6;
        font-family: var(--font-sans);
        font-size: 13px;
        outline: none;
      }

      .upcycling-form input::placeholder {
        color: rgba(244, 239, 230, 0.25);
      }

      .upcycling-form button {
        padding: 13px 22px;
        background: #C4913A;
        border: none;
        cursor: pointer;
        font-family: var(--font-sans);
        font-size: 10px;
        letter-spacing: 2px;
        font-weight: 500;
        color: #080808;
        transition: background 0.2s ease;
      }

      .upcycling-form button:hover {
        background: #DDB86A;
      }

      .upcycling-success {
        font-family: var(--font-sans);
        font-size: 13px;
        font-weight: 300;
        color: #C4913A;
        letter-spacing: 1px;
        text-align: center;
        margin-top: 20px;
      }

      .upcycling-modal-note {
        font-size: 10px;
        letter-spacing: 2px;
        color: rgba(244, 239, 230, 0.2);
        margin-top: 16px;
        text-align: center;
        text-transform: uppercase;
      }

      @keyframes fadeUp {
        from {
          opacity: 0;
          transform: translate(-50%, -42px);
        }
        to {
          opacity: 1;
          transform: translate(-50%, -50%);
        }
      }

      @media (max-width: 560px) {
        .upcycling-modal-card {
          padding: 40px 24px;
        }

        .upcycling-form {
          flex-direction: column;
        }

        .upcycling-form input {
          border-right: 1px solid rgba(196, 145, 58, 0.2);
          margin-bottom: 8px;
        }
      }
    </style>

    <!-- Global scripts: image loaded state + scroll effects -->
    <script>
      // Add 'loaded' class to images after they load for smooth fade-in
      document.querySelectorAll('img[loading="lazy"]').forEach(img => {
        if (img.complete) {
          img.classList.add('loaded');
        } else {
          img.addEventListener('load', () => img.classList.add('loaded'));
          img.addEventListener('error', () => img.classList.add('loaded'));
        }
      });

      // Nav scroll effect — add shadow on scroll
      const header = document.getElementById('header');
      if (header) {
        let ticking = false;
        window.addEventListener('scroll', () => {
          if (!ticking) {
            requestAnimationFrame(() => {
              if (window.scrollY > 50) {
                header.classList.add('scrolled');
              } else {
                header.classList.remove('scrolled');
              }
              ticking = false;
            });
            ticking = true;
          }
        }, { passive: true });
      }

      const storageKey = 'zhUpcyclingShown';
      const modal = document.getElementById('upcycling-modal');
      const closeButtons = document.querySelectorAll('[data-close-upcycling]');
      const form = document.querySelector('[data-upcycling-form]');
      const successMessage = document.querySelector('[data-upcycling-success]');
      const triggerLinks = document.querySelectorAll('[data-open-upcycling-modal]');

      function setModalOpen(isOpen) {
        if (!modal) return;
        modal.setAttribute('aria-hidden', String(!isOpen));
        document.body.style.overflow = isOpen ? 'hidden' : '';
      }

      function openModal() {
        if (!modal) return;
        sessionStorage.setItem(storageKey, 'true');
        setModalOpen(true);
      }

      function closeModal() {
        setModalOpen(false);
      }

      if (modal) {
        if (!sessionStorage.getItem(storageKey)) {
          window.setTimeout(() => {
            openModal();
          }, 3000);
        }

        closeButtons.forEach((button) => {
          button.addEventListener('click', closeModal);
        });

        modal.addEventListener('click', (event) => {
          if (event.target === modal) {
            closeModal();
          }
        });

        document.addEventListener('keydown', (event) => {
          if (event.key === 'Escape' && modal.getAttribute('aria-hidden') === 'false') {
            closeModal();
          }
        });

        triggerLinks.forEach((link) => {
          link.addEventListener('click', (event) => {
            event.preventDefault();
            openModal();
          });
        });

        form?.addEventListener('submit', (event) => {
          event.preventDefault();
          form.setAttribute('hidden', 'true');
          successMessage?.removeAttribute('hidden');
        });
      }
    </script>
  </body>
</html>
