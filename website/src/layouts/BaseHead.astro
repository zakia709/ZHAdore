---
// src/layouts/BaseHead.astro
// SEO meta tags, Open Graph, Twitter Cards, structured data
import { site } from '@data/site';

export interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  canonicalURL?: string;
  noindex?: boolean;
}

const {
  title = `${site.name} — ${site.collection} · ${site.season} | Handmade Luxury Fashion`,
  description = site.description,
  ogImage = site.ogImage,
  canonicalURL = site.url,
  noindex = false,
} = Astro.props;

const fullOgImage = ogImage.startsWith('http') ? ogImage : `${site.url}${ogImage}`;
---

<!-- Primary Meta -->
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalURL} />

<!-- Robots -->
{noindex ? (
  <meta name="robots" content="noindex, follow" />
) : (
  <meta name="robots" content="index, follow" />
)}
<meta name="googlebot" content={noindex ? 'noindex, follow' : 'index, follow'} />

<!-- Open Graph -->
<meta property="og:type" content="website" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={fullOgImage} />
<meta property="og:image:width" content={String(site.ogImageWidth)} />
<meta property="og:image:height" content={String(site.ogImageHeight)} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:site_name" content={site.name} />
<meta property="og:locale" content={site.locale} />

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={fullOgImage} />
<meta name="twitter:site" content={site.twitterHandle} />
<meta name="twitter:creator" content={site.twitterHandle} />

<!-- Icons & PWA -->
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="apple-touch-icon" href="/favicon.svg" />
<link rel="manifest" href="/manifest.json" />
<meta name="theme-color" content={site.themeColor} />

<!-- Preconnect for Google Fonts -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

<!-- Google Fonts: Playfair Display + Jost -->
<link
  href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,300;0,400;0,700;1,300;1,400&family=Jost:wght@200;300;400;500;900&display=swap"
  rel="stylesheet"
/>
