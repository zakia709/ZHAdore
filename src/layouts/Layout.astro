---
interface Props {
  title?: string;
}
const { title = 'ZHADORE — SS 2026' } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,300;0,400;0,700;1,300;1,400&family=Jost:wght@200;300;400;500;900&display=swap" rel="stylesheet" />
</head>
<body>
  <canvas id="ambient-canvas" aria-hidden="true"></canvas>
  <slot />
  <script>
    // ── Cursor
    const c  = document.getElementById('c')!;
    const cr = document.getElementById('cr')!;
    let mx = 0, my = 0, rx = 0, ry = 0;
    document.addEventListener('mousemove', e => {
      mx = e.clientX; my = e.clientY;
      c.style.transform = `translate(${mx - 4}px,${my - 4}px)`;
    });
    (function animRing() {
      rx += (mx - rx - 16) * 0.12;
      ry += (my - ry - 16) * 0.12;
      cr.style.transform = `translate(${rx}px,${ry}px)`;
      requestAnimationFrame(animRing);
    })();

    // ── Nav scroll
    const nav = document.getElementById('nav')!;
    window.addEventListener('scroll', () => {
      nav.classList.toggle('scrolled', scrollY > 60);
    }, { passive: true });

    // ── IntersectionObserver scroll reveals
    const io = new IntersectionObserver(
      entries => entries.forEach(e => { if (e.isIntersecting) { (e.target as HTMLElement).classList.add('in'); } }),
      { threshold: 0.08, rootMargin: '0px 0px -60px 0px' }
    );
    document.querySelectorAll('.reveal').forEach(el => io.observe(el));

    // ── Ambient sparkle motes (site-wide)
    const ac = document.getElementById('ambient-canvas') as HTMLCanvasElement;
    const ax = ac.getContext('2d')!;
    function resizeAmbient() { ac.width = window.innerWidth; ac.height = window.innerHeight; }
    resizeAmbient();
    window.addEventListener('resize', resizeAmbient, { passive: true });

    type Mote = { x: number; y: number; vx: number; vy: number; r: number; a: number; glow: number; };
    function newMote(fromBottom?: boolean): Mote {
      return {
        x:    Math.random() * window.innerWidth,
        y:    fromBottom ? window.innerHeight + 4 : Math.random() * window.innerHeight,
        vx:   (Math.random() - .5) * .18,
        vy:   -(Math.random() * .38 + .1),
        r:    Math.random() * 1.6 + .5,
        a:    Math.random() * .38 + .14,
        glow: Math.random() * 6 + 3,
      };
    }
    const motes: Mote[] = Array.from({ length: 42 }, () => newMote());

    (function drawMotes() {
      ax.clearRect(0, 0, ac.width, ac.height);
      for (let i = 0; i < motes.length; i++) {
        const m = motes[i];
        m.x += m.vx; m.y += m.vy;
        if (m.x < 0) m.x = ac.width;
        if (m.x > ac.width) m.x = 0;
        if (m.y < -2) { motes[i] = newMote(true); continue; }
        ax.shadowBlur  = m.glow;
        ax.shadowColor = `rgba(255,210,80,${m.a * .9})`;
        ax.beginPath();
        ax.arc(m.x, m.y, m.r, 0, Math.PI * 2);
        ax.fillStyle = `rgba(240,210,100,${m.a})`;
        ax.fill();
      }
      ax.shadowBlur = 0;
      requestAnimationFrame(drawMotes);
    })();

    // ── Sparkle burst on person-card hover
    document.querySelectorAll('.person-card').forEach(el => {
      el.addEventListener('mouseenter', () => {
        const rect = (el as HTMLElement).getBoundingClientRect();
        for (let i = 0; i < 16; i++) {
          const s = document.createElement('div');
          const isSmall = i % 4 === 0;
          s.className = isSmall ? 'sparkle sparkle-sm' : 'sparkle';
          const x = rect.left + Math.random() * rect.width;
          const y = rect.top  + Math.random() * rect.height;
          const angle = Math.random() * Math.PI * 2;
          const dist  = 35 + Math.random() * 75;
          const delay = i * 35;
          s.style.cssText = `left:${x.toFixed(1)}px;top:${y.toFixed(1)}px;--dx:${(Math.cos(angle)*dist).toFixed(1)}px;--dy:${(Math.sin(angle)*dist).toFixed(1)}px;animation-delay:${delay}ms`;
          document.body.appendChild(s);
          setTimeout(() => s.remove(), 1100 + delay);
        }
      });
    });
  </script>
</body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
