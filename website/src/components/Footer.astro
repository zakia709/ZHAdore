---
// src/components/Footer.astro
// Enhanced 5-column footer: Brand, Explore, Collections, Connect, Legal
import { contact, site } from '@data/site';
const currentYear = new Date().getFullYear();
const yearDisplay = currentYear > site.copyright.startYear ? `${site.copyright.startYear}–${currentYear}` : String(currentYear);
---

<footer>
  <div class="footer-gold-line" aria-hidden="true"></div>

  <div class="footer-top container">
    <!-- Col 1: Brand -->
    <div class="footer-col footer-brand">
      <div class="f-logo">ZHADORE</div>
      <p class="f-tagline">{site.tagline}</p>
      <p class="f-desc">A handbuilt luxury fashion brand by Zhareal Popa &amp; Zakia Yesmin. Every piece made with intention. Every stitch tells a story.</p>
      <div class="f-social">
        <a href={contact.instagram.url} class="f-social-link" target="_blank" rel="noopener noreferrer" aria-label="ZHADORE on Instagram">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5" fill="none" stroke="currentColor" stroke-width="1.5"/><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="1.5"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>
        </a>
        <a href={`mailto:${contact.email.address}`} class="f-social-link" aria-label="Email ZHADORE">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2" fill="none" stroke="currentColor" stroke-width="1.5"/><polyline points="2,4 12,13 22,4" fill="none" stroke="currentColor" stroke-width="1.5"/></svg>
        </a>
        <a href="https://www.linkedin.com/in/zhareal-popa-/" class="f-social-link" target="_blank" rel="noopener noreferrer" aria-label="Zhareal Popa on LinkedIn">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="3" fill="none" stroke="currentColor" stroke-width="1.5"/><line x1="7" y1="10" x2="7" y2="18" stroke="currentColor" stroke-width="1.5"/><line x1="11" y1="10" x2="11" y2="18" stroke="currentColor" stroke-width="1.5"/><circle cx="7" cy="7" r="1" fill="currentColor" stroke="none"/><path d="M11 14c0-1.5 1-2.5 2.5-2.5S16 12.5 16 14v4" fill="none" stroke="currentColor" stroke-width="1.5"/></svg>
        </a>
      </div>
    </div>

    <!-- Col 2: Explore -->
    <div class="footer-col">
      <h4 class="f-col-title">Explore</h4>
      <nav aria-label="Explore">
        <a href="/collection">Collection Gallery</a>
        <a href="#collection">Lookbook</a>
        <a href="#themes">Themes</a>
        <a href="/story">Our Story</a>
        <a href="#about">The Founders</a>
        <a href="#contact">Contact</a>
      </nav>
    </div>

    <!-- Col 3: Collections -->
    <div class="footer-col">
      <h4 class="f-col-title">SS 2026</h4>
      <nav aria-label="Collections">
        <a href="#bae-cay">Dressed in Intention</a>
        <a href="#business">It's Business Babe</a>
        <a href="#extravagent">Extra-Vagent</a>
        <a href="/collection">All 14 Looks</a>
        <a href="/story">The Philosophy</a>
        <a href="/story">The Journey</a>
      </nav>
    </div>

    <!-- Col 4: Connect -->
    <div class="footer-col">
      <h4 class="f-col-title">Connect</h4>
      <nav aria-label="Contact">
        <a href={`mailto:${contact.email.address}`}>{contact.email.display}</a>
        <a href={contact.instagram.url} target="_blank" rel="noopener noreferrer">{contact.instagram.display}</a>
      </nav>
      <div class="f-locations">
        <div class="f-loc-group">
          <span class="f-loc-label">Design Studio</span>
          <span class="f-loc">{contact.locations.design}</span>
        </div>
        <div class="f-loc-group">
          <span class="f-loc-label">Digital Operations</span>
          <span class="f-loc">{contact.locations.tech}</span>
        </div>
      </div>
    </div>

    <!-- Col 5: Legal -->
    <div class="footer-col">
      <h4 class="f-col-title">Information</h4>
      <nav aria-label="Legal">
        <a href="/privacy">Privacy Policy</a>
        <a href="/terms">Terms of Service</a>
        <a href="/accessibility">Accessibility Statement</a>
        <a href="#contact">Press Inquiries</a>
        <a href="#contact">Collaborations</a>
        <a href="#contact">Custom Orders</a>
      </nav>
    </div>
  </div>

  <div class="footer-bottom container">
    <div class="footer-bottom-left">
      <p class="f-copy">&copy; {yearDisplay} {site.copyright.holder} &middot; {site.copyright.notice}</p>
      <p class="f-credit">Designed in Portland &middot; Built in New York</p>
    </div>
    <div class="footer-bottom-right">
      <span class="f-collection-tag">{site.collection} &middot; {site.season}</span>
    </div>
  </div>
</footer>

<style>
  footer { padding: var(--space-4xl) 0 var(--space-lg); background: var(--color-bg); border-top: 1px solid var(--color-border); }
  .footer-gold-line { height: 1px; background: linear-gradient(90deg,transparent,var(--color-gold) 20%,var(--color-gold-light) 50%,var(--color-gold) 80%,transparent); margin-bottom: var(--space-3xl); }
  .footer-top { display: grid; grid-template-columns: 1.5fr 1fr 1fr 1fr 1.2fr; gap: var(--space-xl); margin-bottom: var(--space-3xl); }
  .f-logo { font-family: var(--font-serif); font-size: var(--text-2xl); font-weight: 700; letter-spacing: var(--tracking-wide); color: var(--color-gold); margin-bottom: var(--space-sm); }
  .f-tagline { font-family: var(--font-sans); font-size: var(--text-sm); font-weight: 300; font-style: italic; color: var(--color-text-secondary); margin-bottom: var(--space-md); }
  .f-desc { font-size: var(--text-sm); color: var(--color-text-muted); line-height: var(--leading-relaxed); margin-bottom: var(--space-lg); max-width: 280px; }
  .f-social { display: flex; gap: var(--space-sm); }
  .f-social-link { display: flex; align-items: center; justify-content: center; width: 36px; height: 36px; border: 1px solid var(--color-border); color: var(--color-text-muted); transition: all var(--transition-fast); }
  .f-social-link:hover { color: var(--color-gold); border-color: var(--color-gold-dim); }
  .f-col-title { font-family: var(--font-sans); font-size: var(--text-xs); font-weight: 500; letter-spacing: var(--tracking-widest); text-transform: uppercase; color: var(--color-gold); margin-bottom: var(--space-lg); }
  .footer-col nav { display: flex; flex-direction: column; gap: var(--space-sm); }
  .footer-col nav a { font-family: var(--font-sans); font-size: var(--text-sm); font-weight: 300; color: var(--color-text-secondary); transition: color var(--transition-fast); }
  .footer-col nav a:hover { color: var(--color-gold); }
  .f-locations { margin-top: var(--space-lg); display: flex; flex-direction: column; gap: var(--space-md); }
  .f-loc-group { display: flex; flex-direction: column; gap: 2px; }
  .f-loc-label { font-family: var(--font-sans); font-size: var(--text-xs); font-weight: 400; letter-spacing: var(--tracking-wider); text-transform: uppercase; color: var(--color-text-muted); }
  .f-loc { font-family: var(--font-sans); font-size: var(--text-sm); color: var(--color-text-secondary); }
  .footer-bottom { display: flex; justify-content: space-between; align-items: flex-end; padding-top: var(--space-xl); border-top: 1px solid var(--color-border); }
  .f-copy { font-family: var(--font-sans); font-size: var(--text-xs); font-weight: 300; color: var(--color-text-muted); letter-spacing: var(--tracking-wider); margin-bottom: var(--space-xs); }
  .f-credit { font-family: var(--font-sans); font-size: var(--text-xs); font-weight: 300; color: var(--color-text-muted); margin-bottom: 0; }
  .f-collection-tag { font-family: var(--font-serif); font-size: var(--text-sm); font-weight: 400; font-style: italic; color: var(--color-text-muted); }

  @media (max-width: 1100px) { .footer-top { grid-template-columns: repeat(3, 1fr); } .footer-brand { grid-column: span 3; } .f-desc { max-width: 100%; } }
  @media (max-width: 768px) { .footer-top { grid-template-columns: repeat(2, 1fr); } .footer-brand { grid-column: span 2; } .footer-bottom { flex-direction: column; align-items: center; text-align: center; gap: var(--space-md); } }
  @media (max-width: 480px) { .footer-top { grid-template-columns: 1fr; } .footer-brand { grid-column: span 1; } }
</style>
