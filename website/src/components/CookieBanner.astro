---
// src/components/CookieBanner.astro
// Minimal cookie consent banner — essential cookies only
---

<div class="cookie-banner" id="cookie-banner" role="region" aria-label="Cookie notice">
  <p class="cookie-message">
    This website uses only essential cookies to ensure proper functionality.
    We do not use tracking, analytics, or advertising cookies.
  </p>
  <button class="cookie-dismiss" id="cookie-dismiss" type="button">
    Got it
  </button>
</div>

<style>
  .cookie-banner {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: var(--z-cookie);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-md);
    padding: var(--space-md) var(--content-padding);
    background: var(--color-bg-elevated);
    border-top: 1px solid var(--color-border);
    transition: transform var(--transition-base), opacity var(--transition-base);
  }

  .cookie-banner.hidden {
    transform: translateY(100%);
    opacity: 0;
    pointer-events: none;
  }

  .cookie-message {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    margin-bottom: 0;
    max-width: 600px;
  }

  .cookie-dismiss {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--color-bg);
    background: var(--color-gold);
    border: none;
    padding: var(--space-sm) var(--space-lg);
    cursor: pointer;
    border-radius: var(--radius-sm);
    white-space: nowrap;
    transition: background var(--transition-fast);
  }

  .cookie-dismiss:hover {
    background: var(--color-gold-light);
  }

  @media (max-width: 600px) {
    .cookie-banner {
      flex-direction: column;
      text-align: center;
    }
  }
</style>

<script>
  const STORAGE_KEY = 'zhadore-cookie-consent';

  function hideBanner() {
    const banner = document.getElementById('cookie-banner');
    if (banner) {
      banner.classList.add('hidden');
    }
  }

  // Check if consent already given
  if (localStorage.getItem(STORAGE_KEY) === 'true') {
    hideBanner();
  } else {
    const dismiss = document.getElementById('cookie-dismiss');
    if (dismiss) {
      dismiss.addEventListener('click', () => {
        localStorage.setItem(STORAGE_KEY, 'true');
        hideBanner();
      });
    }
  }
</script>
