---
---
<section class="hero" id="hero">
  <canvas id="silk-canvas"></canvas>
  <canvas id="particle-canvas"></canvas>

  <!-- animated gold line -->
  <div class="hero-gold-line">
    <svg class="hero-line-svg" viewBox="0 0 1440 3" preserveAspectRatio="none">
      <defs>
        <linearGradient id="goldGrad" x1="0%" y1="0%" x2="100%" y2="0%">
          <stop offset="0%"   stop-color="transparent"/>
          <stop offset="20%"  stop-color="#C4913A"/>
          <stop offset="50%"  stop-color="#E8C878"/>
          <stop offset="80%"  stop-color="#C4913A"/>
          <stop offset="100%" stop-color="transparent"/>
        </linearGradient>
      </defs>
      <line
        class="gold-line-path"
        x1="0" y1="1.5" x2="1440" y2="1.5"
        stroke="url(#goldGrad)"
        stroke-width="1.5"
        stroke-dasharray="1440"
        stroke-dashoffset="1440"
      />
    </svg>
  </div>

  <!-- 3D title -->
  <div class="hero-content">
    <div class="hero-text-3d" id="hero-text">
      <div class="hero-title-wrap">
        <span class="hero-zh">ZH</span><span class="hero-adore">ADORE</span>
      </div>
      <div class="hero-rule"></div>
      <p class="hero-subtitle">A FASHION PORTFOLIO &nbsp;·&nbsp; SS 2026</p>
    </div>
  </div>

  <!-- scroll hint -->
  <div class="hero-scroll">
    <div class="hero-scroll-line"></div>
    <span>SCROLL</span>
  </div>
</section>

<script>
  // ── Particle canvas
  const canvas = document.getElementById('particle-canvas') as HTMLCanvasElement;
  const ctx    = canvas.getContext('2d')!;

  function resizeCanvas() {
    canvas.width  = window.innerWidth;
    canvas.height = window.innerHeight;
  }
  resizeCanvas();
  window.addEventListener('resize', resizeCanvas, { passive: true });

  type Particle = { x: number; y: number; vx: number; vy: number; r: number; a: number; };

  function spawnParticle(): Particle {
    return {
      x:  Math.random() * window.innerWidth,
      y:  Math.random() * window.innerHeight,
      vx: (Math.random() - .5) * .2,
      vy: -(Math.random() * .35 + .08),
      r:  Math.random() * 1.8 + .3,
      a:  Math.random() * .45 + .08,
    };
  }

  const particles: Particle[] = Array.from({ length: 60 }, spawnParticle);

  function drawParticles() {
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    for (let i = 0; i < particles.length; i++) {
      const p = particles[i];
      p.x += p.vx; p.y += p.vy;
      if (p.x < 0) p.x = canvas.width;
      if (p.x > canvas.width) p.x = 0;
      if (p.y < 0) {
        particles[i] = { ...spawnParticle(), y: canvas.height };
        continue;
      }
      ctx.beginPath();
      ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
      ctx.fillStyle = `rgba(196,145,58,${p.a})`;
      ctx.fill();
    }
    requestAnimationFrame(drawParticles);
  }
  drawParticles();

  // ── Mouse parallax tilt
  const heroEl   = document.getElementById('hero')!;
  const heroText = document.getElementById('hero-text')!;

  heroEl.addEventListener('mousemove', e => {
    const r   = heroEl.getBoundingClientRect();
    const dx  = (e.clientX - r.left - r.width  / 2) / (r.width  / 2);
    const dy  = (e.clientY - r.top  - r.height / 2) / (r.height / 2);
    heroText.style.transform = `rotateY(${dx * 6}deg) rotateX(${-dy * 6}deg)`;
  });
  heroEl.addEventListener('mouseleave', () => {
    heroText.style.transform = 'rotateY(0deg) rotateX(0deg)';
  });
</script>

<script>
  // ── Silk wave canvas
  const silk = document.getElementById('silk-canvas') as HTMLCanvasElement;
  const sx   = silk.getContext('2d')!;

  function resizeSilk() {
    silk.width  = window.innerWidth;
    silk.height = window.innerHeight;
  }
  resizeSilk();
  window.addEventListener('resize', resizeSilk, { passive: true });

  let phase      = 0;
  let targetAmp  = 80;
  let currentAmp = 80;

  // Mouse: cursor Y controls wave amplitude
  const silkHero = document.getElementById('hero')!;
  silkHero.addEventListener('mousemove', (e: MouseEvent) => {
    const r = silkHero.getBoundingClientRect();
    const ny = (e.clientY - r.top) / r.height; // 0 = top, 1 = bottom
    targetAmp = 110 - ny * 60;                  // top→110px, bottom→50px
  });
  silkHero.addEventListener('mouseleave', () => { targetAmp = 80; });

  function drawWave(yOff: number, phaseOff: number, opacity: number, amp: number) {
    const W = silk.width;
    const H = silk.height;
    const cy   = H / 2 + yOff;
    const freq = (Math.PI * 2 * 1.5) / W;

    // ── filled body below the crest
    const grad = sx.createLinearGradient(0, cy - amp, 0, H);
    grad.addColorStop(0,    `rgba(255,255,255,${+(0.06  * opacity).toFixed(3)})`);
    grad.addColorStop(0.35, `rgba(255,255,255,${+(0.022 * opacity).toFixed(3)})`);
    grad.addColorStop(1,    `rgba(0,0,0,0)`);

    sx.beginPath();
    sx.moveTo(0, H);
    for (let x = 0; x <= W; x += 3) {
      sx.lineTo(x, cy + amp * Math.sin(freq * x + phase + phaseOff));
    }
    sx.lineTo(W, H);
    sx.closePath();
    sx.fillStyle = grad;
    sx.fill();

    // ── crest path (reused for all three glow passes)
    sx.beginPath();
    sx.moveTo(0, cy + amp * Math.sin(phase + phaseOff));
    for (let x = 3; x <= W; x += 3) {
      sx.lineTo(x, cy + amp * Math.sin(freq * x + phase + phaseOff));
    }

    // Pass 1 — wide outer halo
    sx.shadowBlur  = 40;
    sx.shadowColor = `rgba(255,255,255,${+(0.6  * opacity).toFixed(2)})`;
    sx.strokeStyle = `rgba(255,255,255,${+(0.05 * opacity).toFixed(3)})`;
    sx.lineWidth   = 4;
    sx.stroke();

    // Pass 2 — mid glow
    sx.shadowBlur  = 20;
    sx.shadowColor = `rgba(255,255,255,${+(0.5  * opacity).toFixed(2)})`;
    sx.strokeStyle = `rgba(255,255,255,${+(0.15 * opacity).toFixed(3)})`;
    sx.lineWidth   = 2;
    sx.stroke();

    // Pass 3 — sharp bright crest line
    sx.shadowBlur  = 2;
    sx.shadowColor = `rgba(255,255,255,${+opacity.toFixed(2)})`;
    sx.strokeStyle = `rgba(255,255,255,${+(0.8  * opacity).toFixed(3)})`;
    sx.lineWidth   = 1;
    sx.stroke();

    sx.shadowBlur = 0;
  }

  (function animateSilk() {
    sx.clearRect(0, 0, silk.width, silk.height);

    // Lerp amplitude towards target
    currentAmp += (targetAmp - currentAmp) * 0.05;

    // Draw back-to-front so primary wave is on top
    drawWave(-20,  0.5,  0.25, currentAmp * 0.9); // faint, above
    drawWave( 30,  1.2,  0.6,  currentAmp);        // medium, below
    drawWave(  0,  0,    1.0,  currentAmp);         // primary

    phase += 0.003;
    requestAnimationFrame(animateSilk);
  })();
</script>
