---
// src/layouts/LegalLayout.astro
// Layout for legal pages — simpler header, no animations, focused reading
import BaseHead from './BaseHead.astro';
import SkipLink from '@components/SkipLink.astro';
import Footer from '@components/Footer.astro';
import CookieBanner from '@components/CookieBanner.astro';
import '@styles/global.css';

export interface Props {
  title?: string;
  description?: string;
  canonicalURL?: string;
}
const props = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <BaseHead {...props} />
  </head>
  <body>
    <SkipLink />
    
    <header class="legal-header">
      <div class="container">
        <a href="/" class="legal-logo" aria-label="ZHADORE — Back to home">ZHADORE</a>
        <span class="legal-season">{'SS 2026'}</span>
      </div>
    </header>

    <main id="main-content" class="legal-main">
      <div class="container legal-container">
        <slot />
      </div>
    </main>

    <Footer />
    <CookieBanner />
  </body>
</html>

<style>
  .legal-header {
    position: sticky;
    top: 0;
    z-index: var(--z-nav);
    background: rgba(10, 10, 10, 0.95);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--color-border);
    padding: var(--space-md) 0;
  }

  .legal-header .container {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .legal-logo {
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    font-weight: 700;
    letter-spacing: var(--tracking-wide);
    color: var(--color-gold);
  }

  .legal-logo:hover {
    color: var(--color-gold-light);
  }

  .legal-season {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: 400;
    letter-spacing: var(--tracking-widest);
    color: var(--color-text-muted);
    text-transform: uppercase;
  }

  .legal-main {
    padding: var(--space-4xl) 0 var(--space-5xl);
    min-height: 60vh;
  }

  .legal-container {
    max-width: 780px;
  }

  .legal-container :global(h1) {
    font-size: var(--text-3xl);
    font-weight: 700;
    color: var(--color-gold);
    margin-bottom: var(--space-xl);
  }

  .legal-container :global(h2) {
    font-size: var(--text-xl);
    font-weight: 700;
    margin-top: var(--space-2xl);
    margin-bottom: var(--space-md);
    color: var(--color-text);
  }

  .legal-container :global(h3) {
    font-size: var(--text-lg);
    font-weight: 500;
    font-family: var(--font-sans);
    margin-top: var(--space-xl);
    margin-bottom: var(--space-sm);
    color: var(--color-text-secondary);
  }

  .legal-container :global(p) {
    margin-bottom: var(--space-md);
    line-height: var(--leading-relaxed);
  }

  .legal-container :global(ul), 
  .legal-container :global(ol) {
    margin-bottom: var(--space-md);
    padding-left: var(--space-lg);
  }

  .legal-container :global(li) {
    margin-bottom: var(--space-xs);
    color: var(--color-text-secondary);
  }

  .legal-container :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: var(--space-lg) 0;
    font-size: var(--text-sm);
  }

  .legal-container :global(th),
  .legal-container :global(td) {
    padding: var(--space-sm) var(--space-md);
    border: 1px solid var(--color-border);
    text-align: left;
  }

  .legal-container :global(th) {
    font-weight: 500;
    color: var(--color-gold);
    background: var(--color-bg-elevated);
  }

  .legal-container :global(a) {
    color: var(--color-gold);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .legal-container :global(a:hover) {
    color: var(--color-gold-light);
  }

  .legal-container :global(strong) {
    font-weight: 500;
    color: var(--color-text);
  }
</style>
