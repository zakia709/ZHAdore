---
// src/components/PersonCard.astro
// Founder profile card — avatar, label, name, role, bio, social links
export interface Props {
  initial: string;
  label: string;
  name: string;
  role: string;
  bio: string;
  accentColor: string;
  email: string;
  linkedin: string;
  emailLabel: string;
  linkedinLabel: string;
}
const { initial, label, name, role, bio, accentColor, email, linkedin, emailLabel, linkedinLabel } = Astro.props;
---

<article
  class="person-card"
  style={`--accent:${accentColor}; --avatar-bg:${accentColor === '#C4913A' ? 'rgba(196,145,58,0.1)' : 'rgba(210,210,220,0.06)'}`}
>
  <div class="person-avatar" aria-hidden="true">{initial}</div>
  <div class="person-label">{label}</div>
  <h3 class="person-name">{name}</h3>
  <div class="person-role">{role}</div>
  <p class="person-bio">{bio}</p>

  <div class="person-links">
    <a href={`mailto:${email}`} class="person-link" aria-label={emailLabel}>
      <svg class="person-link-icon" viewBox="0 0 24 24" aria-hidden="true" width="18" height="18">
        <rect x="2" y="4" width="20" height="16" rx="2" fill="none" stroke="currentColor" stroke-width="1.5"/>
        <polyline points="2,4 12,13 22,4" fill="none" stroke="currentColor" stroke-width="1.5"/>
      </svg>
      <span class="sr-only">{emailLabel}</span>
    </a>
    <a href={linkedin} class="person-link" aria-label={linkedinLabel} target="_blank" rel="noopener noreferrer">
      <svg class="person-link-icon" viewBox="0 0 24 24" aria-hidden="true" width="18" height="18">
        <rect x="2" y="2" width="20" height="20" rx="3" fill="none" stroke="currentColor" stroke-width="1.5"/>
        <line x1="7" y1="10" x2="7" y2="18" stroke="currentColor" stroke-width="1.5"/>
        <line x1="11" y1="10" x2="11" y2="18" stroke="currentColor" stroke-width="1.5"/>
        <path d="M7 7.5a1 1 0 1 1 2 0 1 1 0 1 1-2 0" fill="currentColor" stroke="none"/>
        <path d="M11 14c0-1.5 1-2.5 2.5-2.5S16 12.5 16 14v4" fill="none" stroke="currentColor" stroke-width="1.5"/>
      </svg>
      <span class="sr-only">{linkedinLabel}</span>
    </a>
  </div>
</article>

<style>
  .person-card {
    text-align: center;
    padding: var(--space-2xl);
    border: 1px solid var(--color-border);
    background: var(--color-bg-elevated);
    transition: border-color var(--transition-base);
  }

  .person-card:hover {
    border-color: var(--accent);
  }

  .person-avatar {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    background: var(--avatar-bg);
    color: var(--accent);
    font-family: var(--font-serif);
    font-size: var(--text-2xl);
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto var(--space-lg);
    border: 1px solid var(--accent);
  }

  .person-label {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: 400;
    letter-spacing: var(--tracking-widest);
    color: var(--color-gold);
    text-transform: uppercase;
    margin-bottom: var(--space-sm);
  }

  .person-name {
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    font-weight: 700;
    letter-spacing: var(--tracking-wide);
    color: var(--color-text);
    margin-bottom: var(--space-xs);
  }

  .person-role {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: 300;
    color: var(--color-text-secondary);
    margin-bottom: var(--space-lg);
  }

  .person-bio {
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    color: var(--color-text-secondary);
    margin-bottom: var(--space-lg);
  }

  .person-links {
    display: flex;
    justify-content: center;
    gap: var(--space-md);
  }

  .person-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border: 1px solid var(--color-border);
    border-radius: 50%;
    color: var(--color-text-secondary);
    transition: all var(--transition-fast);
  }

  .person-link:hover {
    color: var(--accent);
    border-color: var(--accent);
  }
</style>
