---
// src/pages/story.astro
// ZHADORE — Brand Story & Origin Page
import BaseLayout from '@layouts/BaseLayout.astro';
import GoldLine from '@components/GoldLine.astro';
import { site } from '@data/site';
---

<BaseLayout
  title="Our Story — ZHADORE"
  description="The story behind ZHADORE — two women, one brand. Built from scratch in Portland and New York. Discover the origin of the AMBIVALENCE SS 2026 collection."
  canonicalURL="https://zhadore.com/story"
>

  <div class="story-page">
    <!-- Hero Banner -->
    <section class="story-hero">
      <div class="story-hero-bg" aria-hidden="true"></div>
      <div class="container story-hero-content fade-in-up">
        <div class="eyebrow">THE ORIGIN</div>
        <h1>Two Women.<br />One Brand.</h1>
        <p class="story-hero-sub">Built from scratch. Still building.</p>
        <GoldLine animate={true} />
      </div>
    </section>

    <!-- Origin Story -->
    <section class="story-section container">
      <div class="story-grid">
        <div class="story-text reveal">
          <h2>Where It Began</h2>
          <p>
            ZHADORE was born at the intersection of craft and code — two women, two disciplines, one vision. 
            Zhareal Popa had been designing garments since she could hold a needle, earning her degree in 
            Apparel Design from Oregon State University. Zakia Yesmin had been building digital experiences, 
            studying Business Information Systems in New York.
          </p>
          <p>
            They met through a shared belief: that fashion had lost its soul to mass production, and that 
            the future belonged to brands that understood both the art of the garment <em>and</em> the code 
            behind the brand.
          </p>
          <p>
            ZHADORE is the answer. Every piece is handbuilt by Zhareal. Every pixel and strategy is crafted 
            by Zakia. Together, they're proving that a two-woman operation can move with the precision and 
            impact of a much larger house — because they're not just running a brand. They're building an 
            empire, one intentional stitch at a time.
          </p>
        </div>
        <div class="story-visual reveal" aria-hidden="true">
          <div class="story-card">
            <div class="story-card-inner">
              <span class="story-initial">Z</span>
              <span class="story-initial-label">HADORE</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Philosophy -->
    <section class="story-section story-philosophy">
      <div class="container">
        <div class="reveal text-center">
          <div class="eyebrow">OUR PHILOSOPHY</div>
          <h2 class="section-heading">The Deeper the Shadow</h2>
          <div class="rule rule-centered"></div>
        </div>
        <div class="philosophy-grid reveal">
          <div class="philosophy-card">
            <div class="philosophy-icon" aria-hidden="true">✦</div>
            <h3>Handbuilt</h3>
            <p>Every ZHADORE piece is constructed by hand — no mass production, no assembly lines. Each garment carries the fingerprint of its maker.</p>
          </div>
          <div class="philosophy-card">
            <div class="philosophy-icon" aria-hidden="true">◆</div>
            <h3>Intentional</h3>
            <p>Nothing is accidental. Every seam, every drape, every fabric choice is deliberate. We design with purpose, not for trends.</p>
          </div>
          <div class="philosophy-card">
            <div class="philosophy-icon" aria-hidden="true">◈</div>
            <h3>Worn Like Armor</h3>
            <p>ZHADORE garments are not just clothing — they are protection, confidence, a second skin that empowers the woman who wears it.</p>
          </div>
          <div class="philosophy-card">
            <div class="philosophy-icon" aria-hidden="true">⬡</div>
            <h3>One-of-One</h3>
            <p>We design for the woman who doesn't fit a mold and doesn't want to. Every piece is as unique as the person it's made for.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Timeline -->
    <section class="story-section container">
      <div class="reveal text-center">
        <div class="eyebrow">THE JOURNEY</div>
        <h2 class="section-heading">From Thread to Empire</h2>
        <div class="rule rule-centered"></div>
      </div>
      <div class="timeline reveal">
        <div class="timeline-item">
          <div class="timeline-year">2024</div>
          <div class="timeline-content">
            <h3>The Spark</h3>
            <p>Zhareal graduates from Oregon State University with a degree in Apparel Design. Zakia begins her studies in Business Information Systems. Two paths, one future.</p>
          </div>
        </div>
        <div class="timeline-item">
          <div class="timeline-year">2025</div>
          <div class="timeline-content">
            <h3>ZHADORE Is Born</h3>
            <p>The brand launches. Zhareal's one-of-one custom pieces gain attention. Zakia builds the digital foundation — website, strategy, presence.</p>
          </div>
        </div>
        <div class="timeline-item">
          <div class="timeline-year">2026</div>
          <div class="timeline-content">
            <h3>AMBIVALENCE</h3>
            <p>The first full collection drops: DRESSED IN INTENTION, IT'S BUSINESS BABE, EXTRA-VAGENT. 4 looks. Three themes. One statement.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="story-section story-cta">
      <div class="container text-center reveal">
        <div class="section-divider" style="margin-bottom: var(--space-3xl);"></div>
        <h2 class="section-heading">Be Part of the Story</h2>
        <p class="section-subtitle" style="margin: 0 auto var(--space-xl);">
          We're just getting started. Follow the journey, wear the vision.
        </p>
        <div class="cta-links">
          <a href="/#collection" class="btn btn-primary">View the Collection</a>
          <a href="/#contact" class="btn btn-ghost">Get in Touch</a>
        </div>
      </div>
    </section>
  </div>

</BaseLayout>

<style>
  .story-page {
    overflow-x: hidden;
  }

  /* Hero */
  .story-hero {
    position: relative;
    min-height: 70vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    overflow: hidden;
  }

  .story-hero-bg {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse at 30% 60%, rgba(196, 145, 58, 0.06) 0%, transparent 50%),
      radial-gradient(ellipse at 70% 40%, rgba(232, 200, 120, 0.04) 0%, transparent 50%),
      var(--color-bg);
  }

  .story-hero-content {
    position: relative;
    z-index: 2;
  }

  .story-hero-content h1 {
    font-family: var(--font-serif);
    font-size: var(--text-4xl);
    font-weight: 700;
    color: var(--color-text);
    margin: var(--space-lg) 0;
    line-height: 1.15;
  }

  .story-hero-sub {
    font-family: var(--font-sans);
    font-size: var(--text-lg);
    font-weight: 300;
    color: var(--color-text-secondary);
    margin-bottom: var(--space-xl);
  }

  /* Story Grid */
  .story-section {
    padding: var(--section-padding) 0;
  }

  .story-grid {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: var(--space-3xl);
    align-items: center;
  }

  .story-text h2 {
    font-size: var(--text-2xl);
    font-weight: 700;
    margin-bottom: var(--space-lg);
    color: var(--color-text);
  }

  .story-text p {
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-lg);
  }

  .story-visual {
    display: flex;
    justify-content: center;
  }

  .story-card {
    width: 280px;
    height: 280px;
    border: 1px solid var(--color-gold-dim);
    background: var(--color-bg-elevated);
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .story-card::before {
    content: '';
    position: absolute;
    inset: -1px;
    border: 1px solid var(--color-gold);
    opacity: 0.3;
  }

  .story-card-inner {
    text-align: center;
  }

  .story-initial {
    font-family: var(--font-serif);
    font-size: 96px;
    font-weight: 700;
    color: var(--color-gold);
    line-height: 0.8;
    display: block;
  }

  .story-initial-label {
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    font-weight: 400;
    color: var(--color-text-secondary);
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    margin-top: var(--space-sm);
    display: block;
  }

  /* Philosophy */
  .story-philosophy {
    background: var(--color-bg-elevated);
  }

  .text-center { text-align: center; }

  .philosophy-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-lg);
    margin-top: var(--space-3xl);
  }

  .philosophy-card {
    text-align: center;
    padding: var(--space-xl);
    border: 1px solid var(--color-border);
    transition: border-color var(--transition-base);
  }

  .philosophy-card:hover {
    border-color: var(--color-gold-dim);
  }

  .philosophy-icon {
    font-size: var(--text-2xl);
    color: var(--color-gold);
    margin-bottom: var(--space-md);
  }

  .philosophy-card h3 {
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    font-weight: 700;
    margin-bottom: var(--space-sm);
  }

  .philosophy-card p {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  /* Timeline */
  .timeline {
    position: relative;
    margin-top: var(--space-3xl);
    padding-left: var(--space-2xl);
    border-left: 1px solid var(--color-gold-dim);
  }

  .timeline-item {
    position: relative;
    margin-bottom: var(--space-2xl);
    padding-bottom: var(--space-md);
  }

  .timeline-item::before {
    content: '';
    position: absolute;
    left: calc(-1 * var(--space-2xl) - 4px);
    top: 4px;
    width: 8px;
    height: 8px;
    background: var(--color-gold);
    border-radius: 50%;
  }

  .timeline-year {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: var(--tracking-widest);
    color: var(--color-gold);
    text-transform: uppercase;
    margin-bottom: var(--space-sm);
  }

  .timeline-content h3 {
    font-size: var(--text-xl);
    font-weight: 700;
    margin-bottom: var(--space-xs);
  }

  .timeline-content p {
    font-size: var(--text-base);
    max-width: 500px;
  }

  /* CTA */
  .story-cta {
    padding-bottom: var(--space-5xl);
  }

  .cta-links {
    display: flex;
    justify-content: center;
    gap: var(--space-lg);
    flex-wrap: wrap;
  }

  /* Reveal */
  .reveal {
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 0.8s ease, transform 0.8s ease;
  }

  .reveal.visible {
    opacity: 1;
    transform: translateY(0);
  }

  @media (max-width: 900px) {
    .story-grid {
      grid-template-columns: 1fr;
    }
    .story-visual { order: -1; }
    .philosophy-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 560px) {
    .philosophy-grid {
      grid-template-columns: 1fr;
    }
    .timeline {
      padding-left: var(--space-lg);
    }
    .cta-links {
      flex-direction: column;
      align-items: center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .reveal { opacity: 1; transform: none; transition: none; }
  }
</style>

<script>
  // Reveal on scroll
  const reveals = document.querySelectorAll('.reveal');
  if ('IntersectionObserver' in window) {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => { if (entry.isIntersecting) { entry.target.classList.add('visible'); observer.unobserve(entry.target); } });
    }, { threshold: 0.1 });
    reveals.forEach(el => observer.observe(el));
  } else {
    reveals.forEach(el => el.classList.add('visible'));
  }
</script>
