---
// src/components/GoldLine.astro
// Animated SVG gold gradient line — reusable signature brand element
export interface Props { animate?: boolean }
const { animate = true } = Astro.props;
---
<div class="gold-line" aria-hidden="true">
  <svg class="gold-line-svg" viewBox="0 0 1440 3" preserveAspectRatio="none">
    <defs>
      <linearGradient id="goldGrad" x1="0%" y1="0%" x2="100%" y2="0%">
        <stop offset="0%" stop-color="transparent"/><stop offset="20%" stop-color="#C4913A"/>
        <stop offset="50%" stop-color="#E8C878"/><stop offset="80%" stop-color="#C4913A"/>
        <stop offset="100%" stop-color="transparent"/>
      </linearGradient>
    </defs>
    <line class="gold-line-path" x1="0" y1="1.5" x2="1440" y2="1.5" stroke="url(#goldGrad)" stroke-width="1.5" stroke-dasharray="1440" stroke-dashoffset={animate ? '1440' : '0'}></line>
  </svg>
</div>
<style>
  .gold-line { width: 100%; height: 3px; }
  .gold-line-svg { display: block; width: 100%; height: 3px; }
  .gold-line-path { animation: goldDraw 1.5s cubic-bezier(0.4,0,0.2,1) forwards; animation-delay: 0.5s; }
  @keyframes goldDraw { to { stroke-dashoffset: 0; } }
  @media (prefers-reduced-motion: reduce) {
    .gold-line-path { animation: none; stroke-dashoffset: 0; }
  }
</style>
